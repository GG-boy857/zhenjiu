---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeStudyPath from "../components/HomeStudyPath.tsx";
import DataPanel from "../components/DataPanel.tsx";
import BronzeFigure3D from "../components/BronzeFigure3D.tsx";
import { acupointList, getMeridian, meridians } from "../lib/data";

const pathIds = ["lung", "large-intestine", "stomach"];
const studyPath = pathIds
  .map((id) => getMeridian(id))
  .filter((m) => !!m)
  .map((m) => ({
    id: m!.id,
    name: m!.name,
    nameEn: m!.nameEn,
    code: m!.code,
    color: m!.color,
    description: m!.description,
    points: m!.points,
  }));

const pointsBrief = Object.fromEntries(
  acupointList.map((p) => [p.code, { name: p.name, nameEn: p.nameEn }])
);

const bronzePoints = acupointList
  .filter((p) => p.svg.front || p.svg.back)
  .map((p) => ({
    code: p.code,
    name: p.name,
    nameEn: p.nameEn,
    meridianId: p.meridianId,
    color: getMeridian(p.meridianId)?.color ?? "#8a8272",
    front: p.svg.front,
    back: p.svg.back,
  }));

const bronzeMeridians = meridians
  .filter((m) => m.points.length > 0 || m.jiaohui?.length)
  .map((m) => ({ id: m.id, name: m.name, color: m.color, jiaohui: m.jiaohui }));

const quickLinks = [
  { href: "/meridians/", title: "经络穴位", desc: "按十二正经与奇经八脉浏览全部穴位" },
  { href: "/atlas/", title: "人体穴位图", desc: "在人体轮廓上直观查看穴位位置" },
  { href: "/review/", title: "复习自测", desc: "闪卡与定位选择题，检验学习成果" },
  { href: "/search/", title: "全局搜索", desc: "按穴名、拼音、代码或主治检索" },
];
const withBase = (p: string) => import.meta.env.BASE_URL.replace(/\/$/, "") + p;
---

<BaseLayout title="首页">
  <!-- Hero -->
  <section class="paper-card relative overflow-hidden p-8 md:p-12">
    <p class="text-sm tracking-[0.3em] text-vermilion">个人针灸学习手札</p>
    <h1 class="mt-3 text-4xl font-bold leading-snug md:text-5xl">以穴为字，以经为篇</h1>
    <p class="mt-4 max-w-2xl text-[15px] leading-8 text-ink-soft">
      从手太阴肺经开始，循十二正经次第推进：先记定位，再明主治，后通操作。
      这里收录我自学的经络穴位笔记——数据按国家标准整理，进度保存在本地浏览器，随时可查、可测、可备份。
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={withBase("/meridians/lung/")} class="rounded-md bg-vermilion px-5 py-2.5 font-bold text-paper transition-colors hover:bg-vermilion-soft">
        从肺经开始学 →
      </a>
      <a href={withBase("/atlas/")} class="rounded-md border border-line bg-card px-5 py-2.5 font-bold text-ink-soft transition-colors hover:border-qing-soft hover:text-qing">
        打开穴位图
      </a>
    </div>
    <p class="mt-6 text-sm text-ink-faint">
      已收录 {meridians.length} 条经络 · {acupointList.length} 个穴位（十四经全部录入；冲、带、跷、维等六脉为交会穴，无独立经穴）
    </p>
  </section>

  <!-- 学习路径 -->
  <section class="mt-10">
    <h2 class="section-title">学习路径</h2>
    <p class="mt-2 mb-4 text-sm text-ink-soft">
      建议按“肺经 → 大肠经 → 胃经”的顺序推进，与十二经脉气血流注次序一致；每学完一穴，可在详情页标记“已学习”。
    </p>
    <HomeStudyPath client:load items={studyPath} />
  </section>

  <!-- 3D 针灸铜人 -->
  <section class="mt-10">
    <h2 class="section-title">3D 针灸铜人</h2>
    <p class="mt-2 mb-4 max-w-3xl text-sm leading-7 text-ink-soft">
      拖拽旋转、滚轮缩放、悬停查看穴位名称、点击进入详情页；右上按钮可转至正面或背面，
      并支持「皮肤 / 肌肉」图层切换——肌肉视图下皮肤半透明，可观察穴位深部的肌肉结构。
      361 穴经射线投射吸附于真实人体体表（按 GB/T 12346 相对位置定位），属教学示意，精确取穴以各穴文字定位为准。
      解剖网格数据来源 BodyParts3D（CC BY-SA 2.1 JP），署名见 <a href={`${import.meta.env.BASE_URL}/ATTRIBUTION.md`} class="text-qing hover:underline" target="_blank" rel="noopener noreferrer">ATTRIBUTION.md</a>。
    </p>
    <div id="bronze3d" class="paper-card overflow-hidden">
      <BronzeFigure3D client:visible points={bronzePoints} meridians={bronzeMeridians} />
    </div>
  </section>

  <!-- 快速入口 + 数据 -->
  <section class="mt-10 grid gap-4 md:grid-cols-2">
    <div class="grid gap-3 sm:grid-cols-2">
      {
        quickLinks.map((l) => (
          <a href={withBase(l.href)} class="paper-card block p-4">
            <h3 class="font-bold group-hover:text-vermilion">{l.title}</h3>
            <p class="mt-1 text-xs leading-5 text-ink-faint">{l.desc}</p>
          </a>
        ))
      }
    </div>
    <DataPanel client:load pointsBrief={pointsBrief} />
  </section>

  <!-- 经络速览 -->
  <section class="mt-10">
    <h2 class="section-title">经络速览</h2>
    <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4">
      {
        meridians.map((m) => (
          <a
            href={withBase(`/meridians/${m.id}/`)}
            class:list={[
              "flex items-center gap-2 rounded-md border border-line bg-card px-3 py-2 text-sm transition-colors hover:border-ink-soft",
              m.points.length === 0 && !m.jiaohui?.length && "opacity-55",
            ]}
          >
            <span class="h-2.5 w-2.5 shrink-0 rounded-full" style={`background-color:${m.color}`} />
            <span class="truncate">{m.name}</span>
            {m.points.length > 0 && (
              <span class="ml-auto shrink-0 text-xs text-ink-faint">{m.points.length}</span>
            )}
          </a>
        ))
      }
    </div>
    <p class="mt-2 text-xs text-ink-faint">
      十四经已全量收录（361 经穴）；冲、带、跷、维六脉见各经络页的交会穴与穴位图循行示意线。
    </p>
  </section>
</BaseLayout>
