---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="页面未找到">
  <div class="paper-card mx-auto max-w-xl p-12 text-center">
    <p class="text-5xl font-bold text-vermilion">404</p>
    <p class="mt-3 text-lg">此路不通——该页面不存在或尚未生成。</p>
    <div class="mt-6 flex justify-center gap-3">
      <a href="/" class="rounded-md bg-vermilion px-5 py-2 font-bold text-paper hover:bg-vermilion-soft">
        回到首页
      </a>
      <a href="/meridians/" class="rounded-md border border-line px-5 py-2 text-ink-soft hover:border-qing-soft hover:text-qing">
        浏览经络
      </a>
    </div>
  </div>
</BaseLayout>
